{
  "rules": {
    ".read": false,
    ".write": false,
    
    "activeRides": {
      ".read": "auth != null",
      "$rideId": {
        ".write": "auth != null && ((data.child('clientId').val() === auth.uid && !data.exists()) || (data.child('driverId').val() === auth.uid) || (!data.exists() && auth != null))",
        ".validate": "newData.hasChildren(['id', 'clientId', 'status', 'origin', 'destination'])"
      }
    },
    
    "driverLocations": {
      ".read": "auth != null",
      "$driverId": {
        ".write": "auth != null && auth.uid === $driverId"
      }
    },
    
    "driversInfo": {
      ".read": "auth != null",
      "$driverId": {
        ".write": "auth != null && auth.uid === $driverId"
      }
    },
    
    "paymentStatus": {
      "$rideId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['rideId', 'status', 'method', 'amount'])",
        
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(initiated|authorized|pending_confirmation|in_progress|pending_capture|completed|confirmed|canceled|partial_charged|pending_cash_payment|failed|refunded)$/)"
        },
        
        "method": {
          ".validate": "newData.isString() && newData.val().matches(/^(cash|card|stripe)$/)"
        },
        
        "provider": {
          ".validate": "newData.isString() && newData.val().matches(/^(cash|stripe|local)$/)"
        },
        
        "amount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        
        "tip": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        
        "total": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    
    "chats": {
      "$rideId": {
        "messages": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$messageId": {
            ".validate": "newData.hasChildren(['senderId', 'senderName', 'message', 'timestamp', 'rideId'])"
          }
        },
        "typing": {
          "$userId": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid === $userId"
          }
        },
        "metadata": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    
    "presence": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $userId"
      }
    },
    
    "clientLocations": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $userId",
        ".validate": "newData.hasChildren(['latitude', 'longitude', 'isManual', 'timestamp'])"
      }
    }
  }
}
