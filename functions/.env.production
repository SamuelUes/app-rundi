# ============================================
# FIREBASE FUNCTIONS .env - Producción Rundi (PROD)
# VALORES VACÍOS: rellena con las credenciales del nuevo proyecto oficial
# ============================================

# ============================================
# SUPABASE POSTGRESQL (PROD)
# ============================================
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_PASSWORD=

EXPO_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=

# ============================================
# MIGRACIÓN: BANDERAS DE COMPATIBILIDAD
# (ajusta a false cuando ya no dependas de RTDB)
# ============================================
MIRROR_PENALTIES_TO_RTDB=true
LOG_DRIVER_COMMISSION_PAYMENTS_TO_RTDB=true
USE_RTDB_DESIGNATED_DRIVER_REQUESTS=true
SYNC_DRIVERS_STATIC_TO_RTDB=true
SYNC_DRIVER_RIDES_TO_RTDB=true

# ============================================
# CLOUDINARY (Upload de imágenes)
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# MAPS APIs (PROD)
# ============================================
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=
TOMTOM_API_KEY=


# ============================================
# GOOGLE OAUTH 2.0 (Autenticación)
# ============================================
REACT_APP_GOOGLE_CLIENT_ID=
