# ============================================
# FIREBASE FUNCTIONS - ENVIRONMENT VARIABLES
# ============================================
# IMPORTANTE: Este es un archivo de ejemplo
# Copia este archivo como .env y completa con tus valores reales


# ============================================
# SUPABASE (PostgreSQL)
# ============================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Connection String para PostgreSQL directo
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.tu-proyecto.supabase.co:5432/postgres

# ============================================
# SEQUELIZE (ORM - PostgreSQL)
# ============================================
DB_NAME=driveangel
DB_USER=postgres
DB_PASSWORD=tu-password-aqui
DB_HOST=db.tu-proyecto.supabase.co
DB_PORT=5432

# Alternativas (Supabase)
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=tu-password-aqui
SUPABASE_DB_HOST=db.tu-proyecto.supabase.co
SUPABASE_DB_PORT=5432

# ============================================
# STRIPE (Pagos)
# ============================================
STRIPE_SECRET_KEY=sk_test_tu-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_tu-webhook-secret

# ============================================
# FIREBASE ADMIN SDK
# ============================================
# Nota: El service account JSON se configura automáticamente en Firebase Functions
# No es necesario agregarlo aquí si usas firebase deploy

# ============================================
# GOOGLE MAPS API
# ============================================
GOOGLE_MAPS_API_KEY=tu-google-maps-api-key

# ============================================
# TWILIO (SMS/WhatsApp) - OPCIONAL
# ============================================
TWILIO_ACCOUNT_SID=tu-twilio-account-sid
TWILIO_AUTH_TOKEN=tu-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# SENDGRID (Email) - OPCIONAL
# ============================================
SENDGRID_API_KEY=tu-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@tuapp.com

# ============================================
# CONFIGURACIÓN DE LA APP
# ============================================
NODE_ENV=development
APP_URL=https://tuapp.com
FRONTEND_URL=https://tuapp.com

# ============================================
# REDIS (Cache) - OPCIONAL
# ============================================
REDIS_URL=redis://default:password@host:port
UPSTASH_REDIS_REST_URL=https://tu-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu-token

# ============================================
# SENTRY (Error Tracking) - OPCIONAL
# ============================================
SENTRY_DSN=https://tu-sentry-dsn@sentry.io/proyecto

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. Copia este archivo como .env en la misma carpeta
# 2. Completa todos los valores con tus credenciales reales
# 3. NUNCA compartas el archivo .env con nadie
# 4. NUNCA subas el archivo .env al repositorio
# 5. Cada desarrollador debe tener su propio .env local
