        "amount": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "tip": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "total": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "finalAmount": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "createdAt": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0)" },
        "updatedAt": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0)" },
        "lastUpdatedAt": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0)" },
        "lastUpdatedBy": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },

        "driverId": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
        "clientId": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
        "requiresClientPayment": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "chargeTarget": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
        "chargeType": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
        "shouldCharge": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "chargeAmount": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "negotiatedFare": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "progress": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "commissionDue": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "driverPayout": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },

        "code": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
        "codeGeneratedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "codeGeneratedBy": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
        "authentication_method": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
        "biometric_type": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
        "biometric_authenticated": { ".validate": "!newData.exists() || newData.isBoolean()" },

        "confirmedByClient": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "confirmedByDriver": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "clientConfirmedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "driverConfirmedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "confirmedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },

        "canceledAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "canceledBy": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
        "canceledById": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
        "cancelReason": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },

        "$other": { ".validate": "false" }
      }
    },

    "clientPendingPayments": {
      "$clientId": {
        ".read": "auth != null && auth.uid === $clientId",
        ".write": false,
        "summary": {
          ".read": "auth != null && auth.uid === $clientId",
          ".write": false
        }
      }
    },
    
    "chats": {
      "$rideId": {
        ".read": "auth != null && (root.child('activeRides/' + $rideId + '/clientId').val() === auth.uid || root.child('activeRides/' + $rideId + '/driverId').val() === auth.uid || root.child('programmedRides/' + $rideId + '/clientId').val() === auth.uid || root.child('programmedRides/' + $rideId + '/driverId').val() === auth.uid)",
        ".write": "auth != null && (root.child('activeRides/' + $rideId + '/clientId').val() === auth.uid || root.child('activeRides/' + $rideId + '/driverId').val() === auth.uid || root.child('programmedRides/' + $rideId + '/clientId').val() === auth.uid || root.child('programmedRides/' + $rideId + '/driverId').val() === auth.uid)",
        "messages": {
          ".read": "auth != null && (root.child('activeRides/' + $rideId + '/clientId').val() === auth.uid || root.child('activeRides/' + $rideId + '/driverId').val() === auth.uid || root.child('programmedRides/' + $rideId + '/clientId').val() === auth.uid || root.child('programmedRides/' + $rideId + '/driverId').val() === auth.uid)",
          ".write": "auth != null && (newData.child('senderId').val() === auth.uid)",
          "$messageId": {
            ".validate": "!newData.exists() || newData.hasChildren(['senderId', 'senderName', 'message', 'timestamp', 'rideId'])"
          }
        },
        "typing": {
          "$userId": {
            ".read": "auth != null && (root.child('activeRides/' + $rideId + '/clientId').val() === auth.uid || root.child('activeRides/' + $rideId + '/driverId').val() === auth.uid || root.child('programmedRides/' + $rideId + '/clientId').val() === auth.uid || root.child('programmedRides/' + $rideId + '/driverId').val() === auth.uid)",
            ".write": "auth != null && auth.uid === $userId"
          }
        },
        "metadata": {
          ".read": "auth != null && (root.child('activeRides/' + $rideId + '/clientId').val() === auth.uid || root.child('activeRides/' + $rideId + '/driverId').val() === auth.uid || root.child('programmedRides/' + $rideId + '/clientId').val() === auth.uid || root.child('programmedRides/' + $rideId + '/driverId').val() === auth.uid)",
          ".write": "auth != null && (root.child('activeRides/' + $rideId + '/clientId').val() === auth.uid || root.child('activeRides/' + $rideId + '/driverId').val() === auth.uid || root.child('programmedRides/' + $rideId + '/clientId').val() === auth.uid || root.child('programmedRides/' + $rideId + '/driverId').val() === auth.uid)"
        }
      }
    },

    "calls": {
      ".indexOn": ["clientUid", "operatorUid", "status"],
      "$callId": {
        ".read": "auth != null && (auth.uid === data.child('clientUid').val() || auth.uid === data.child('operatorUid').val())",
        ".write": "auth != null && (auth.uid === data.child('clientUid').val() || auth.uid === data.child('operatorUid').val() || auth.uid === newData.child('clientUid').val() || auth.uid === newData.child('operatorUid').val())",
        ".validate": "newData.hasChildren(['callId','status','direction','operatorUid','clientUid','createdAt','updatedAt']) && newData.child('status').val().matches(/^(initiated|ringing_client|ringing_operator|accepted|rejected|missed|connected|ended)$/) && newData.child('direction').val().matches(/^(operator_to_client|client_to_operator)$/)",

        "callId": { ".validate": "newData.isString()" },
        "complaintId": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
        "rideId": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
        "operatorUid": { ".validate": "newData.isString()" },
        "clientUid": { ".validate": "newData.isString()" },
        "status": { ".validate": "newData.isString()" },
        "direction": { ".validate": "newData.isString()" },
        "recordingUrl": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
        "acceptDeadline": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "updatedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "connectedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "endedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },

        "offers": {
          "$userId": {
            ".read": "auth != null && (auth.uid === data.parent().child('clientUid').val() || auth.uid === data.parent().child('operatorUid').val())",
            ".write": "auth != null && auth.uid === $userId",
            ".validate": "newData.hasChildren(['sdp','type','createdAt'])"
          }
        },
        "answers": {
          "$userId": {
            ".read": "auth != null && (auth.uid === data.parent().child('clientUid').val() || auth.uid === data.parent().child('operatorUid').val())",
            ".write": "auth != null && auth.uid === $userId",
            ".validate": "newData.hasChildren(['sdp','type','createdAt'])"
          }
        },
        "candidates": {
          "$candidateId": {
            ".read": "auth != null && (auth.uid === data.parent().child('clientUid').val() || auth.uid === data.parent().child('operatorUid').val())",
            ".write": "auth != null && (auth.uid === data.parent().child('clientUid').val() || auth.uid === data.parent().child('operatorUid').val())",
            ".validate": "newData.hasChildren(['candidate','sdpMid','sdpMLineIndex','createdAt'])"
          }
        },
        "events": {
          "$eventId": {
            ".read": "auth != null && (auth.uid === data.parent().child('clientUid').val() || auth.uid === data.parent().child('operatorUid').val())",
            ".write": "auth != null && (auth.uid === data.parent().child('clientUid').val() || auth.uid === data.parent().child('operatorUid').val())",
            ".validate": "newData.hasChildren(['type','at'])"
          }
        },

        "$other": { ".validate": "false" }
      }
    },

    "presence": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId",
        "$other": { ".validate": "false" }
      }
    },
    
    "clientsLocations": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId",
        ".validate": "!newData.exists() || newData.hasChildren(['latitude', 'longitude', 'isManual', 'timestamp'])",
        "latitude": { ".validate": "newData.isNumber()" },
        "longitude": { ".validate": "newData.isNumber()" },
        "isManual": { ".validate": "newData.isBoolean()" },
        "timestamp": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "coords": {
          ".validate": "!newData.exists() || newData.hasChildren(['latitude', 'longitude'])",
          "latitude": { ".validate": "newData.isNumber()" },
          "longitude": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": "false" }
        },
        "address": { ".validate": "!newData.exists() || newData.isString()" },
        "source": { ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^(manual|gps)$/))" },
        "manualOverride": {
          ".validate": "!newData.exists() || newData.hasChildren(['active'])",
          "active": { ".validate": "newData.isBoolean()" },
          "updatedAt": { ".validate": "!newData.exists() || newData.isString()" },
          "$other": { ".validate": "false" }
        },
        "$other": { ".validate": "false" }
      }
    },

    "clientsLocationsByArea": {
      "$serviceAreaId": {
        "$userId": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $userId",
          ".validate": "!newData.exists() || newData.hasChildren(['latitude', 'longitude', 'isManual', 'timestamp'])",
          "latitude": { ".validate": "newData.isNumber()" },
          "longitude": { ".validate": "newData.isNumber()" },
          "isManual": { ".validate": "newData.isBoolean()" },
          "timestamp": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "coords": {
            ".validate": "!newData.exists() || newData.hasChildren(['latitude', 'longitude'])",
            "latitude": { ".validate": "newData.isNumber()" },
            "longitude": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": "false" }
          },
          "address": { ".validate": "!newData.exists() || newData.isString()" },
          "source": { ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^(manual|gps)$/))" },
          "manualOverride": {
            ".validate": "!newData.exists() || newData.hasChildren(['active'])",
            "active": { ".validate": "newData.isBoolean()" },
            "updatedAt": { ".validate": "!newData.exists() || newData.isString()" },
            "$other": { ".validate": "false" }
          },
          "serviceAreaId": { ".validate": "!newData.exists() || newData.isString()" },
          "$other": { ".validate": "false" }
        }
      }
    },

    "clientsInfo": {
      ".read": "auth != null",
      "$clientId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $clientId",
        "$other": { ".validate": "false" }
      }
    },

    "driverPenalties": {
      "$driverId": {
        ".read": "auth != null && auth.uid === $driverId",
        ".write": false,
        "summary": {
          ".read": "auth != null && auth.uid === $driverId",
          ".write": false
        },
        "$other": { ".validate": "false" }
      }
    },

    "driverCommissionPayments": {
      "$driverId": {
        ".read": "auth != null && auth.uid === $driverId",
        ".write": false,
        "$other": { ".validate": "false" }
      }
    },

    "notifications": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": false,
        "$other": { ".validate": "false" }
      }
    },

    "pendingArchive": {
      "$rideId": {
        ".read": false,
        ".write": false,
        "$other": { ".validate": "false" }
      }
    }
  }
}
