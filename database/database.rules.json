     ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^(manual|gps)$/))"
    },
    "manualOverride": {
     ".validate": "!newData.exists() || newData.hasChildren(['active'])",
     "active": {
      ".validate": "newData.isBoolean()"
     },
     "updatedAt": {
      ".validate": "!newData.exists() || newData.isString()"
     },
     "$other": {
      ".validate": "false"
     }
    },
    "$other": {
     ".validate": "false"
    }
   }
  },
  "clientsLocationsByArea": {
   "$serviceAreaId": {
    "$userId": {
     ".read": "auth != null && root.child('driversInfo/' + auth.uid).exists()",
     ".write": "auth != null && auth.uid === $userId",
     ".validate": "!newData.exists() || newData.hasChildren(['latitude', 'longitude', 'isManual', 'timestamp'])",
     "latitude": {
      ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
     },
     "longitude": {
      ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
     },
     "isManual": {
      ".validate": "newData.isBoolean()"
     },
     "timestamp": {
      ".validate": "newData.isNumber() && newData.val() > 0"
     },
     "coords": {
      ".validate": "!newData.exists() || newData.hasChildren(['latitude', 'longitude'])",
      "latitude": {
       ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
      },
      "longitude": {
       ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
      },
      "$other": {
       ".validate": "false"
      }
     },
     "address": {
      ".validate": "!newData.exists() || newData.isString()"
     },
     "source": {
      ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^(manual|gps)$/))"
     },
     "manualOverride": {
      ".validate": "!newData.exists() || newData.hasChildren(['active'])",
      "active": {
       ".validate": "newData.isBoolean()"
      },
      "updatedAt": {
       ".validate": "!newData.exists() || newData.isString()"
      },
      "$other": {
       ".validate": "false"
      }
     },
     "serviceAreaId": {
      ".validate": "!newData.exists() || newData.isString()"
     },
     "$other": {
      ".validate": "false"
     }
    }
   }
  },
  "clientsInfo": {
   "$clientId": {
    ".read": "auth != null && auth.uid === $clientId",
    ".write": "auth != null && auth.uid === $clientId",
    "$other": {
     ".validate": "false"
    }
   }
  },
  "driverPenalties": {
   "$driverId": {
    ".read": "auth != null && auth.uid === $driverId",
    ".write": false,
    "summary": {
     ".read": "auth != null && auth.uid === $driverId",
     ".write": false
    },
    "$other": {
     ".validate": "false"
    }
   }
  },
  "driverCommissionPayments": {
   "$driverId": {
    ".read": "auth != null && auth.uid === $driverId",
    ".write": false,
    "$other": {
     ".validate": "false"
    }
   }
  },
  "notifications": {
   "$userId": {
    ".read": "auth != null && auth.uid === $userId",
    ".write": false,
    "$other": {
     ".validate": "false"
    }
   }
  },
  "pendingArchive": {
   "$rideId": {
    ".read": false,
    ".write": false,
    "$other": {
     ".validate": "false"
    }
   },
   ".indexOn": [
    "nextRetryAt"
   ]
  },
  "programmedRideCodes": {
   ".read": false,
   ".write": false,
   "$rideId": {
    ".read": "auth != null && data.child('clientId').val() === auth.uid",
    ".write": false
   }
  },
  "rideTrackingCodes": {
   ".read": false,
   ".write": false,
   ".indexOn": ["rideId"],
   "$code": {
    ".read": false,
    ".write": false,
    ".validate": "false"
   }
  },
  "claimCodeIndex": {
   ".read": false,
   ".write": false,
   "$code": {
    ".write": false,
    ".validate": "false"
   }
  },
  "archiveClaims": {
   "$rideId": {
    ".read": false,
    ".write": false,
    "$other": {
     ".validate": "false"
    }
   }
  }
 }
}
