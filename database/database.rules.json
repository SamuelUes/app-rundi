{
  "rules": {
    ".read": false,
    ".write": false,

    "sessions": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "$other": { ".validate": "true" }
      }
    },
    
    "activeRides": {
      ".read": "auth != null",
      "$rideId": {
        ".write": "auth != null",
        ".validate": "data.exists() ? true : newData.hasChildren(['id', 'clientId', 'status', 'origin', 'destination', 'estimatedPrice', 'requestedAt'])",
        
        "id": { ".validate": "newData.isString()" },
        "clientId": { ".validate": "newData.isString()" },
        "driverId": { ".validate": "newData.isString() || newData.val() == null" },
        "status": { ".validate": "newData.isString() && newData.val().matches(/^(requested|driver_offered|accepted|driver_on_route|driver_arrived|in_progress|pending_payment|pending_rating|completed|canceled)$/)" },
        "origin": { ".validate": "!newData.exists() || newData.hasChildren(['lat', 'lng'])" },
        "destination": { ".validate": "!newData.exists() || newData.hasChildren(['lat', 'lng'])" },
        "estimatedPrice": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "estimatedDistance": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "estimatedDuration": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "distance": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "duration": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "finalFare": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "requestedAt": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0)" },
        "acceptedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "startedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "completedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "clientVehiclePhoto": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
        "designatedDriverVehiclePhoto": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
        "lastUpdate": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() > 0"
        },

        "driverLocation": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['latitude', 'longitude']) && newData.child('latitude').isNumber() && newData.child('longitude').isNumber()"
        },

        "clientsLocation": {
          ".write": "auth != null"
        }
      }
    },

    "activeRidesByArea": {
      ".read": "auth != null",
      "$serviceAreaId": {
        "$rideId": {
          ".write": "auth != null",
          ".validate": "data.exists() ? true : newData.hasChildren(['id', 'clientId', 'status', 'origin', 'destination', 'estimatedPrice', 'requestedAt'])",

          "id": { ".validate": "newData.isString()" },
          "clientId": { ".validate": "newData.isString()" },
          "driverId": { ".validate": "newData.isString() || newData.val() == null" },
          "status": { ".validate": "newData.isString() && newData.val().matches(/^(requested|driver_offered|accepted|driver_on_route|driver_arrived|in_progress|pending_payment|pending_rating|completed|canceled)$/)" },
          "origin": { ".validate": "!newData.exists() || newData.hasChildren(['lat', 'lng'])" },
          "destination": { ".validate": "!newData.exists() || newData.hasChildren(['lat', 'lng'])" },
          "estimatedPrice": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
          "estimatedDistance": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
          "estimatedDuration": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
          "distance": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
          "duration": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
          "finalFare": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
          "requestedAt": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0)" },
          "acceptedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
          "startedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
          "completedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
          "clientVehiclePhoto": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
          "designatedDriverVehiclePhoto": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
          "lastUpdate": {
            ".write": "auth != null",
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "$other": { ".validate": "true" }
        }
      }
    },

    "programmedRides": {
      ".read": "auth != null",
      ".indexOn": ["clientId", "driverId"],
      "$rideId": {
        ".write": "auth != null",
        ".validate": "data.exists() ? true : newData.hasChildren(['id', 'clientId', 'status', 'origin', 'destination', 'estimatedPrice', 'scheduledAt'])",

        "id": { ".validate": "newData.isString()" },
        "isProgrammed": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "scheduledAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "clientId": { ".validate": "newData.isString()" },
        "driverId": { ".validate": "newData.isString() || newData.val() == null" },
        "status": { ".validate": "newData.isString()" },
        "origin": { ".validate": "!newData.exists() || newData.hasChildren(['lat', 'lng'])" },
        "destination": { ".validate": "!newData.exists() || newData.hasChildren(['lat', 'lng'])" },
        "estimatedPrice": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "estimatedDistance": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "estimatedDuration": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "clientConfirmedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "driverConfirmedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "clientConfirmed": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "driverConfirmed": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "canceledAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "$other": { ".validate": "true" }
      }
    },

    "programmedRidesByArea": {
      ".read": "auth != null",
      "$serviceAreaId": {
        "$rideId": {
          ".write": "auth != null",
          ".indexOn": ["clientId", "driverId"],
          ".validate": "data.exists() ? true : newData.hasChildren(['id', 'clientId', 'status', 'origin', 'destination', 'estimatedPrice', 'scheduledAt'])",

          "id": { ".validate": "newData.isString()" },
          "isProgrammed": { ".validate": "!newData.exists() || newData.isBoolean()" },
          "scheduledAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "clientId": { ".validate": "newData.isString()" },
          "driverId": { ".validate": "newData.isString() || newData.val() == null" },
          "status": { ".validate": "newData.isString()" },
          "origin": { ".validate": "!newData.exists() || newData.hasChildren(['lat', 'lng'])" },
          "destination": { ".validate": "!newData.exists() || newData.hasChildren(['lat', 'lng'])" },
          "estimatedPrice": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
          "estimatedDistance": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
          "estimatedDuration": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
          "clientConfirmed": { ".validate": "!newData.exists() || newData.isBoolean()" },
          "driverConfirmed": { ".validate": "!newData.exists() || newData.isBoolean()" },
          "$other": { ".validate": "true" }
        }
      }
    },
    
    "driverLocations": {
      ".read": "auth != null",
      "$driverId": {
        ".write": "auth != null && auth.uid === $driverId",
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(available|busy|offline)$/)"
        },
        "lat": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "lng": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "heading": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "speed": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "accuracy": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "$other": { ".validate": "true" }
      }
    },

    "driverLocationsByArea": {
      ".read": "auth != null",
      "$serviceAreaId": {
        "$driverId": {
          ".write": "auth != null && auth.uid === $driverId",
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(available|busy|offline)$/)"
          },
          "lat": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
          "lng": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
          "heading": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
          "speed": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
          "accuracy": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
          "$other": { ".validate": "true" }
        }
      }
    },
    
    "driversInfo": {
      ".read": "auth != null",
      "$driverId": {
        ".write": "auth != null && auth.uid === $driverId",
        "account_status": { 
          ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^(pending|active|inactive|suspended|rejected)$/))" 
        },
        "documents_status": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^(pending|verified|suspended|rejected)$/))"
        },
        "status": {
          ".validate": "newData.val() == null"
        },
        "$other": { ".validate": "true" }
      }
    },

    "drivers": {
      ".read": "auth != null",
      "$driverId": {
        ".write": "auth != null && auth.uid === $driverId",
        "firstName": { ".validate": "newData.isString() || newData.val() == null" },
        "lastName": { ".validate": "newData.isString() || newData.val() == null" },
        "fullName": { ".validate": "newData.isString() || newData.val() == null" },
        "profilePhoto": { ".validate": "newData.isString() || newData.val() == null" },
        "photoURL": { ".validate": "newData.isString() || newData.val() == null" },
        "rating": {
          ".validate": "(newData.isNumber() && newData.val() >= 0 && newData.val() <= 5) || newData.isString() || newData.val() == null"
        },
        "status": { ".validate": "newData.isString() || newData.val() == null" },
        "vehicle": { ".validate": "newData.val() == null || newData.hasChildren(['type']) || newData.isString()" },
        "vehicles": { ".validate": "newData.val() == null || newData.hasChildren(['0'])" },
        "department": { ".validate": "newData.isString() || newData.val() == null" },
        "municipality": { ".validate": "newData.isString() || newData.val() == null" },
        "phone": { ".validate": "newData.isString() || newData.val() == null" },
        "email": { ".validate": "newData.isString() || newData.val() == null" },
        "wallet": {
          ".read": "auth != null && auth.uid === $driverId",
          ".write": false,
          "currentRechargeBalance": {
            ".validate": "newData.isNumber() || newData.val() == null"
          },
          "availableBalance": {
            ".validate": "newData.isNumber() || newData.val() == null"
          },
          "blocked": {
            ".validate": "newData.isBoolean() || newData.val() == null"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() || newData.val() == null"
          },
          "$other": { ".validate": "true" }
        },
        "$other": { ".validate": "true" }
      }
    },
    
    "paymentStatus": {
      ".read": "auth != null",
      "$rideId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "data.exists() ? true : newData.hasChildren(['status'])",
        
        "rideId": {
          ".validate": "newData.isString()"
        },
        
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(pending|pending_confirmation|in_progress|payment_in_progress|processing|payment_completed|completed|canceled|failed)$/)"
        },
        
        "method": {
          ".validate": "newData.isString() && newData.val().matches(/^(cash|card|bank_transfer|code)$/)"
        },
        
        "provider": {
          ".validate": "newData.isString() && newData.val().matches(/^(cash|local|stripe)$/)"
        },
        
        "amount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        
        "tip": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        
        "total": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        
        "confirmedByClient": {
          ".validate": "newData.isBoolean()"
        },
        
        "confirmedByDriver": {
          ".validate": "newData.isBoolean()"
        }
      }
    },

    "clientPendingPayments": {
      "$clientId": {
        ".read": "auth != null && auth.uid === $clientId",
        ".write": false,
        "summary": {
          ".read": "auth != null && auth.uid === $clientId",
          ".write": false
        }
      }
    },
    
    "chats": {
      "$rideId": {
        ".write": "auth != null",
        "messages": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$messageId": {
            ".validate": "!newData.exists() || newData.hasChildren(['senderId', 'senderName', 'message', 'timestamp', 'rideId'])"
          }
        },
        "typing": {
          "$userId": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid === $userId"
          }
        },
        "metadata": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },

    "calls": {
      ".read": "auth != null",
      ".indexOn": ["clientUid", "operatorUid", "status"],
      "$callId": {
        ".read": "auth != null && (auth.uid === data.child('clientUid').val() || auth.uid === data.child('operatorUid').val())",
        ".write": "auth != null && (auth.uid === data.child('clientUid').val() || auth.uid === data.child('operatorUid').val() || auth.uid === newData.child('clientUid').val() || auth.uid === newData.child('operatorUid').val())",
        ".validate": "newData.hasChildren(['callId','status','direction','operatorUid','clientUid','createdAt','updatedAt']) && newData.child('status').val().matches(/^(initiated|ringing_client|ringing_operator|accepted|rejected|missed|connected|ended)$/) && newData.child('direction').val().matches(/^(operator_to_client|client_to_operator)$/)",

        "callId": { ".validate": "newData.isString()" },
        "complaintId": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
        "rideId": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
        "operatorUid": { ".validate": "newData.isString()" },
        "clientUid": { ".validate": "newData.isString()" },
        "status": { ".validate": "newData.isString()" },
        "direction": { ".validate": "newData.isString()" },
        "recordingUrl": { ".validate": "!newData.exists() || newData.isString() || newData.val() == null" },
        "acceptDeadline": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "updatedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "connectedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },
        "endedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() == null" },

        "offers": {
          "$userId": {
            ".read": "auth != null && (auth.uid === data.parent().child('clientUid').val() || auth.uid === data.parent().child('operatorUid').val())",
            ".write": "auth != null && auth.uid === $userId",
            ".validate": "newData.hasChildren(['sdp','type','createdAt'])"
          }
        },
        "answers": {
          "$userId": {
            ".read": "auth != null && (auth.uid === data.parent().child('clientUid').val() || auth.uid === data.parent().child('operatorUid').val())",
            ".write": "auth != null && auth.uid === $userId",
            ".validate": "newData.hasChildren(['sdp','type','createdAt'])"
          }
        },
        "candidates": {
          "$candidateId": {
            ".read": "auth != null && (auth.uid === data.parent().child('clientUid').val() || auth.uid === data.parent().child('operatorUid').val())",
            ".write": "auth != null && (auth.uid === data.parent().child('clientUid').val() || auth.uid === data.parent().child('operatorUid').val())",
            ".validate": "newData.hasChildren(['candidate','sdpMid','sdpMLineIndex','createdAt'])"
          }
        },
        "events": {
          "$eventId": {
            ".read": "auth != null && (auth.uid === data.parent().child('clientUid').val() || auth.uid === data.parent().child('operatorUid').val())",
            ".write": "auth != null && (auth.uid === data.parent().child('clientUid').val() || auth.uid === data.parent().child('operatorUid').val())",
            ".validate": "newData.hasChildren(['type','at'])"
          }
        }
      }
    },

    "presence": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $userId"
      }
    },
    
    "clientsLocations": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $userId",
        ".validate": "!newData.exists() || newData.hasChildren(['latitude', 'longitude', 'isManual', 'timestamp'])"
      }
    },

    "clientsLocationsByArea": {
      "$serviceAreaId": {
        "$userId": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $userId",
          ".validate": "!newData.exists() || newData.hasChildren(['latitude', 'longitude', 'isManual', 'timestamp'])"
        }
      }
    },

    "clientsInfo": {
      ".read": "auth != null",
      "$clientId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $clientId"
      }
    },

    "driverPenalties": {
      "$driverId": {
        ".read": "auth != null && auth.uid === $driverId",
        ".write": false,
        "summary": {
          ".read": "auth != null && auth.uid === $driverId",
          ".write": false
        }
      }
    },

    "driverCommissionPayments": {
      "$driverId": {
        ".read": "auth != null && auth.uid === $driverId",
        ".write": false
      }
    },

    "notifications": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId"
      }
    }
  }
}
