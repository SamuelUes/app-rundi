{
  "description": "Firebase Database Schema - SOLO DATOS EN TIEMPO REAL",
  "updated": "2026-07-17",
  "note": "Este schema es SOLO para Firebase. Datos históricos están en Supabase PostgreSQL",
  
  "firestore": {
    "collections": {
      "users": {
        "description": "Perfiles de usuarios (sincronizado con Firebase Auth)",
        "document_structure": {
          "id": "string (Firebase UID)",
          "email": "string",
          "name": "string",
          "phone": "string",
          "role": "string (client | driver)",
          "profilePhoto": "string | null",
          "driverStatus": "string | null (offline | available | busy)",
          "currentRideId": "string | null",
          "currentLocation": {
            "lat": "number",
            "lng": "number",
            "timestamp": "number"
          },
          "fcmToken": "string | null",
          "notificationsEnabled": "boolean",
          "stats": {
            "totalRides": "number",
            "averageRating": "number",
            "totalEarnings": "number"
          },
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        },
        "indexes": [
          {
            "fields": ["role", "driverStatus"],
            "description": "Buscar conductores disponibles"
          },
          {
            "fields": ["role", "createdAt"],
            "description": "Listar usuarios por fecha"
          }
        ],
        "security_rules": {
          "read": "auth != null",
          "create": "auth != null && request.auth.uid == userId",
          "update": "auth != null && request.auth.uid == userId",
          "delete": "false"
        }
      },

      "cms-users": {
        "description": "Usuarios del CMS (admins y operadores, separados de usuarios finales)",
        "document_structure": {
          "id": "string (Firebase UID)",
          "email": "string",
          "name": "string",
          "role": "string (admin | operator)",
          "assigned_service_areas": [
            "string (ID de service_areas asignada al operador)"
          ],
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        },
        "indexes": [
          {
            "fields": ["role"],
            "description": "Listar usuarios del CMS por rol"
          }
        ],
        "security_rules": {
          "read": "auth != null",
          "create": "isAdmin() (solo via backend/Admin)",
          "update": "isAdmin()",
          "delete": "isAdmin()"
        }
      },

      "cms-gruporzc": {
        "description": "Datos de la empresa (Grupo RZC) para el módulo de finanzas del CMS: perfil legal/fiscal y registros de pagos de obligaciones (DGI, alcaldía, INSS, INATEC)",
        "documents": {
          "company": {
            "description": "Perfil único de la empresa",
            "document_structure": {
              "profile": {
                "legalName": "string (razón social)",
                "tradeName": "string (nombre comercial)",
                "ruc": "string",
                "legalRepName": "string",
                "legalRepId": "string (cédula)",
                "address": "string",
                "municipality": "string",
                "department": "string",
                "phone": "string",
                "email": "string",
                "website": "string",
                "accountantName": "string",
                "accountantPhone": "string",
                "accountantEmail": "string",
                "fiscalYearEnd": "string (MM-DD, típico 12-31)",
                "employeesCount": "number | null",
                "inssRegime": "string (integral | ivm | '')",
                "isWithholdingAgent": "boolean (agente de retención DGI)",
                "hasOwnFleet": "boolean (vehículos propios → rodamiento)",
                "bankName": "string",
                "bankAccount": "string",
                "currency": "string (NIO | USD)",
                "notes": "string"
              },
              "updatedAt": "timestamp",
              "updatedBy": { "uid": "string", "name": "string" }
            }
          },
          "company/obligations/{obligationId}:{period}": {
            "description": "Pago registrado de una obligación fiscal por período (ej. iva:2026-10, matricula:2026)",
            "document_structure": {
              "obligationId": "string (iva | anticipo-ir | retenciones | imi-municipal | inss-patronal | inatec | matricula | dar | rodamiento)",
              "period": "string (YYYY-MM mensual | YYYY anual)",
              "paidAt": "string (YYYY-MM-DD)",
              "amount": "number | null",
              "reference": "string (Nº boleta/recibo)",
              "notes": "string",
              "createdBy": { "uid": "string", "name": "string" },
              "createdAt": "timestamp",
              "updatedAt": "timestamp"
            }
          }
        },
        "security_rules": {
          "read": "isAdmin()",
          "write": "isAdmin() (en la práctica solo Admin SDK desde /api/admin/finance)"
        }
      },

      "service_areas": {
        "description": "Áreas de servicio y cobertura geográfica (Managua, otras ciudades, etc.)",
        "document_structure": {
          "name": "string",
          "countryCode": "string",
          "active": "boolean",
          "centerLat": "number | null",
          "centerLng": "number | null",
          "radiusKm": "number | null",
          "bounds": {
            "north": "number",
            "south": "number",
            "east": "number",
            "west": "number"
          }
        },
        "security_rules": {
          "read": "auth != null",
          "create": "isAdmin()",
          "update": "isAdmin()",
          "delete": "isAdmin()"
        }
      },
      
      "notifications": {
        "description": "Notificaciones de usuarios (subcollection)",
        "path": "notifications/{userId}/items/{notificationId}",
        "document_structure": {
          "id": "string",
          "type": "string (ride_requested | ride_accepted | ride_started | ride_completed | payment_received | new_message | rating_received | driver_nearby)",
          "title": "string",
          "body": "string",
          "data": {
            "rideId": "string (optional)",
            "driverId": "string (optional)",
            "amount": "number (optional)"
          },
          "read": "boolean",
          "readAt": "timestamp | null",
          "createdAt": "timestamp"
        },
        "security_rules": {
          "read": "auth != null && auth.uid == userId",
          "update": "auth != null && auth.uid == userId && only ['read', 'readAt'] modified",
          "create": "false (only via Cloud Functions)",
          "delete": "auth != null && auth.uid == userId"
        }
      }
    }
  },
  
  "realtime_database": {
    "paths": {
      "activeRides": {
        "description": "Viajes activos en tiempo real",
        "path": "activeRides/{rideId}",
        "structure": {
          "id": "string",
          "clientId": "string (Firebase UID)",
          "driverId": "string | null (Firebase UID)",
          "status": "string (requested | searching | accepted | driver_on_route | in_progress | pending_payment | completed | rating_completed | canceled)",
          "origin": {
            "lat": "number",
            "lng": "number",
            "address": "string"
          },
          "destination": {
            "lat": "number",
            "lng": "number",
            "address": "string"
          },
          "driverLocation": {
            "lat": "number",
            "lng": "number",
            "heading": "number (0-360 degrees)",
            "speed": "number (km/h)",
            "accuracy": "number (meters)",
            "timestamp": "number (unix timestamp)"
          },
          "estimatedDistance": "number (meters)",
          "estimatedDuration": "number (seconds)",
          "estimatedPrice": "number (córdobas)",
          "eta": "number | null (minutes)",
          "distanceTraveled": "number (meters)",
          "rideType": "string (normal | premium | shared | designated_driver | designated_driver_moto)",
          "notes": "string | null",
          "requestedAt": "number (unix timestamp)",
          "acceptedAt": "number | null",
          "startedAt": "number | null",
          "lastUpdate": "number (unix timestamp)"
        },
        "security_rules": {
          "read": "auth != null && (data.clientId == auth.uid || data.driverId == auth.uid)",
          "write": "auth != null && (data.clientId == auth.uid || data.driverId == auth.uid || !data.exists())"
        }
      },

      "activeRidesByArea": {
        "description": "Viajes activos, particionados por área de servicio",
        "path": "activeRidesByArea/{serviceAreaId}/{rideId}",
        "structure": {
          "id": "string",
          "clientId": "string (Firebase UID)",
          "driverId": "string | null (Firebase UID)",
          "status": "string (requested | accepted | in_progress | completed | canceled)",
          "origin": {
            "lat": "number",
            "lng": "number",
            "address": "string"
          },
          "destination": {
            "lat": "number",
            "lng": "number",
            "address": "string"
          },
          "estimatedDistance": "number (meters)",
          "estimatedDuration": "number (seconds)",
          "estimatedPrice": "number (córdobas)",
          "requestedAt": "number (unix timestamp)",
          "serviceAreaId": "string (referencia a service_areas)",
          "lastUpdate": "number (unix timestamp)"
        },
        "security_rules": {
          "read": "auth != null",
          "write": "auth != null"
        }
      },
      
      "driverLocations": {
        "description": "Ubicación actual de conductores",
        "path": "driverLocations/{driverId}",
        "structure": {
          "lat": "number",
          "lng": "number",
          "heading": "number",
          "speed": "number",
          "accuracy": "number",
          "status": "string (available | busy)",
          "currentRideId": "string | null",
          "timestamp": "number",
          "lastUpdate": "number"
        },
        "security_rules": {
          "read": "auth != null",
          "write": "auth != null && auth.uid == driverId"
        }
      },

      "driverLocationsByArea": {
        "description": "Ubicación actual de conductores, particionada por área de servicio",
        "path": "driverLocationsByArea/{serviceAreaId}/{driverId}",
        "structure": {
          "lat": "number",
          "lng": "number",
          "heading": "number",
          "speed": "number",
          "accuracy": "number",
          "status": "string (available | busy)",
          "currentRideId": "string | null",
          "timestamp": "number",
          "lastUpdate": "number",
          "serviceAreaId": "string (referencia a service_areas)"
        },
        "security_rules": {
          "read": "auth != null",
          "write": "auth != null && auth.uid == driverId"
        }
      },
      
      "chats": {
        "description": "Chat en tiempo real entre cliente y conductor",
        "paths": {
          "messages": {
            "path": "chats/{rideId}/messages/{messageId}",
            "structure": {
              "id": "string",
              "senderId": "string (Firebase UID)",
              "senderName": "string",
              "senderRole": "string (client | driver)",
              "text": "string",
              "type": "string (text | predefined | location)",
              "timestamp": "number",
              "read": "boolean",
              "readAt": "number | null"
            }
          },
          "typing": {
            "path": "chats/{rideId}/typing/{userId}",
            "structure": {
              "isTyping": "boolean",
              "timestamp": "number"
            }
          },
          "metadata": {
            "path": "chats/{rideId}/metadata",
            "structure": {
              "participants": {
                "[userId]": {
                  "name": "string",
                  "role": "string",
                  "lastSeen": "number"
                }
              },
              "createdAt": "number",
              "lastMessage": {
                "text": "string",
                "timestamp": "number",
                "senderId": "string"
              }
            }
          }
        },
        "security_rules": {
          "messages": {
            "read": "auth != null",
            "write": "auth != null && !data.exists()"
          },
          "typing": {
            "read": "auth != null",
            "write": "auth != null && auth.uid == userId"
          }
        },
        "predefined_messages": [
          { "id": 1, "text": "👍 Ok", "emoji": "👍" },
          { "id": 2, "text": "⏱️ Llegando en 2 minutos", "emoji": "⏱️" },
          { "id": 3, "text": "📍 Ya llegué", "emoji": "📍" },
          { "id": 4, "text": "🚗 En camino", "emoji": "🚗" },
          { "id": 5, "text": "✅ Perfecto", "emoji": "✅" },
          { "id": 6, "text": "❓ ¿Dónde estás?", "emoji": "❓" }
        ]
      },
      
      "presence": {
        "description": "Estado online/offline de usuarios",
        "path": "presence/{userId}",
        "structure": {
          "online": "boolean",
          "lastSeen": "number",
          "device": "string",
          "platform": "string (ios | android | web)"
        },
        "security_rules": {
          "read": "auth != null",
          "write": "auth != null && auth.uid == userId"
        }
      },

      "clientsLocations": {
        "description": "Ubicación actual de clientes (heartbeat y búsqueda de viajes)",
        "path": "clientsLocations/{userId}",
        "structure": {
          "latitude": "number",
          "longitude": "number",
          "isManual": "boolean",
          "timestamp": "number",
          "lastHeartbeat": "number | null"
        },
        "security_rules": {
          "read": "auth != null",
          "write": "auth != null && auth.uid == userId"
        }
      },

      "clientsLocationsByArea": {
        "description": "Ubicación actual de clientes, particionada por área de servicio",
        "path": "clientsLocationsByArea/{serviceAreaId}/{userId}",
        "structure": {
          "latitude": "number",
          "longitude": "number",
          "isManual": "boolean",
          "timestamp": "number",
          "lastHeartbeat": "number | null",
          "serviceAreaId": "string (referencia a service_areas)"
        },
        "security_rules": {
          "read": "auth != null",
          "write": "auth != null && auth.uid == userId"
        }
      },

      "paymentStatus": {
        "description": "Estado de pago de viajes activos",
        "path": "paymentStatus/{rideId}",
        "structure": {
          "status": "string (pending | completed | canceled | failed)",
          "finalAmount": "number",
          "paymentMethod": "string (cash | card | wallet)",
          "cancelReason": "string | null",
          "timestamp": "number"
        },
        "security_rules": {
          "read": "auth != null && (data.child('clientId').val() == auth.uid || data.child('driverId').val() == auth.uid)",
          "write": "auth != null (server-side via Cloud Functions only)"
        },
        "triggers": ["onPaymentCompleted", "onPaymentCanceled"]
      },

      "programmedRides": {
        "description": "Viajes programados pendientes de ejecución",
        "path": "programmedRides/{rideId}",
        "structure": {
          "id": "string",
          "clientId": "string (Firebase UID)",
          "driverId": "string | null (Firebase UID)",
          "status": "string (pending | assigned | confirmed | canceled | expired)",
          "scheduledFor": "number (unix timestamp)",
          "origin": { "lat": "number", "lng": "number", "address": "string" },
          "destination": { "lat": "number", "lng": "number", "address": "string" },
          "rideType": "string (normal | premium | shared | designated_driver | designated_driver_moto)",
          "estimatedPrice": "number",
          "createdAt": "number"
        },
        "security_rules": {
          "read": "auth != null && (data.clientId == auth.uid || data.driverId == auth.uid)",
          "write": "auth != null (server-side via Cloud Functions only)"
        },
        "triggers": ["syncProgrammedRidesByArea"],
        "scheduled_functions": ["processProgrammedRides (every 1 min, maxInstances: 1)"]
      },

      "programmedRidesByArea": {
        "description": "Viajes programados, particionados por área de servicio",
        "path": "programmedRidesByArea/{serviceAreaId}/{rideId}",
        "structure": "Same as programmedRides + serviceAreaId",
        "security_rules": {
          "read": "auth != null",
          "write": "auth != null (server-side via triggers only)"
        }
      },

      "calls": {
        "description": "Llamadas de voz en tiempo real. Señalización en RTDB; la media (audio) va por LiveKit. Dos tipos: soporte (cliente↔operador CMS) y viaje (cliente↔conductor). Source of truth en tiempo real.",
        "path": "calls/{callId}",
        "structure": {
          "callId": "string",
          "callType": "string (support | ride) — ausente en llamadas de soporte antiguas",
          "complaintId": "string | null (solo soporte)",
          "rideId": "string | null",
          "operatorUid": "string | null (Firebase UID, solo soporte)",
          "driverUid": "string | null (Firebase UID, solo ride)",
          "clientUid": "string (Firebase UID)",
          "direction": "string (operator_to_client | client_to_operator | client_to_driver | driver_to_client)",
          "status": "string (initiated | ringing_client | ringing_operator | ringing_driver | accepted | connected | ended | rejected | missed)",
          "acceptDeadline": "number (unix ms, now + 60s al crear)",
          "recordingUrl": "string | null",
          "createdAt": "number",
          "updatedAt": "number",
          "connectedAt": "number | null (lo fija el webhook con ≥2 participantes)",
          "endedAt": "number | null",
          "events": "{ '<pushId>': { type, at, by|source }, 'initiated': { at, by, type, source } }"
        },
        "livekit_rooms": {
          "support": "support-call-{callId}",
          "ride": "ride-call-{callId}"
        },
        "security_rules": {
          "read": "auth != null && (data.clientUid == auth.uid || data.operatorUid == auth.uid || data.driverUid == auth.uid); queries por clientUid/operatorUid/driverUid/rideId limitadas al propio uid o a participantes del viaje",
          "write": "auth != null && auth.uid es uno de los participantes (clientUid | operatorUid | driverUid)"
        },
        "archive_to": "support_call_sessions (soporte) o ride_call_sessions (ride) en PostgreSQL via trigger onCallEnded al finalizar"
      },

      "sessions": {
        "description": "Sesiones activas para control de dispositivo único",
        "path": "sessions/{userId}",
        "structure": {
          "deviceId": "string",
          "lastSeen": "number (unix timestamp)",
          "platform": "string (ios | android | web)"
        },
        "security_rules": {
          "read": "auth != null && auth.uid == userId",
          "write": "auth != null && auth.uid == userId"
        },
        "used_by": "ensureActiveSession() en Cloud Functions para prevenir multi-dispositivo"
      },

      "rideRequests": {
        "description": "Solicitudes de viaje enviadas a conductores específicos",
        "path": "rideRequests/{rideId}/{driverId}",
        "structure": {
          "rideId": "string",
          "driverId": "string (Firebase UID)",
          "offeredPrice": "number",
          "status": "string (pending | accepted | rejected | expired)",
          "timestamp": "number"
        },
        "security_rules": {
          "read": "auth != null && auth.uid == driverId",
          "write": "auth != null (server-side via Cloud Functions only)"
        }
      },

      "notifications": {
        "description": "Notificaciones push en cola (procesadas por Cloud Functions)",
        "path": "notifications/{userId}",
        "structure": {
          "type": "string",
          "title": "string",
          "body": "string",
          "data": "object",
          "timestamp": "number"
        },
        "security_rules": {
          "read": "false (server-side only)",
          "write": "false (server-side only)"
        }
      }
    }
  },
  
  "synchronization_flow": {
    "user_registration": [
      "1. Firebase Auth creates user",
      "2. Cloud Function creates Firestore profile (users collection)",
      "3. If driver: Cloud Function creates PostgreSQL record (drivers table)",
      "4. Cloud Function sets custom claims (role, isDriver/isClient) via syncAppUserRole",
      "5. Frontend receives complete user"
    ],
    "request_ride": [
      "1. Client requests ride via Cloud Function (createRide)",
      "2. Cloud Function validates data with Zod schemas",
      "3. Insert into PostgreSQL (rides table via Sequelize)",
      "4. Publish to Realtime DB (activeRides/{rideId})",
      "5. Geo-sharding trigger syncs to activeRidesByArea/{serviceAreaId}/{rideId}",
      "6. Nearby drivers receive push notification + real-time update",
      "7. Driver can accept, make counter-offer, or reject"
    ],
    "real_time_tracking": [
      "1. Driver accepts ride (acceptRide Cloud Function)",
      "2. Update Realtime DB (activeRides/{rideId}.status = 'accepted')",
      "3. Client listens to real-time changes via onValue",
      "4. Driver sends location every 3 seconds via backgroundLocationService",
      "5. Update Realtime DB (driverLocations/{driverId})",
      "6. Geo-sharding trigger syncs to driverLocationsByArea/{serviceAreaId}/{driverId}",
      "7. Update Realtime DB (activeRides/{rideId}/driverLocation)",
      "8. Client sees location on map in real-time"
    ],
    "complete_ride": [
      "1. Driver completes ride (completeRide Cloud Function)",
      "2. Update Realtime DB (activeRides/{rideId}.status = 'pending_payment')",
      "3. Payment is processed → paymentStatus/{rideId}.status = 'completed'",
      "4. onPaymentCompleted trigger fires:",
      "  4a. saveCompletedRideToSupabase → INSERT/UPDATE rides table (PostgreSQL)",
      "  4b. savePaymentToSupabase → INSERT payments table (PostgreSQL)",
      "  4c. saveRideLocationsToSupabase → INSERT ride_locations table (PostgreSQL)",
      "  4d. Update activeRides/{rideId} with pgRideId + archivedToSupabase=true",
      "  4e. Update activeRides/{rideId}.status = 'completed'",
      "  4f. cleanupRideFromRealtime → removes driverLocations, clientsLocations, chats, etc.",
      "5. onRatingCompleted trigger fires when status → 'rating_completed':",
      "  5a. Wait 15s, then update status to 'completed' if still 'rating_completed'",
      "  5b. Wait 20s more, then delete activeRides/{rideId} if status is 'completed' or 'rating_completed'",
      "6. Scheduled cleanup (cleanupRealtimeDB) removes stale entries periodically"
    ],
    "cancel_ride": [
      "1. Client or driver cancels ride (cancelRide Cloud Function)",
      "2. Update Realtime DB (activeRides/{rideId}.status = 'canceled')",
      "3. onRideCanceled trigger fires:",
      "  3a. saveCanceledRideToSupabase → INSERT/UPDATE rides table with cancel data",
      "  3b. cleanupRideFromRealtime → removes related RTDB entries",
      "4. paymentStatus/{rideId}.status = 'canceled' (if payment was initiated)",
      "5. onPaymentCanceled trigger fires → archives canceled payment to Supabase"
    ],
    "programmed_ride": [
      "1. Client creates programmed ride (createProgrammedRide Cloud Function)",
      "2. Store in Realtime DB (programmedRides/{rideId})",
      "3. Geo-sharding trigger syncs to programmedRidesByArea/{serviceAreaId}/{rideId}",
      "4. processProgrammedRides scheduled function (maxInstances: 1) checks due rides every minute",
      "5. When due: moves to activeRides and notifies nearby drivers"
    ],
    "role_sync": [
      "1. Admin sets role in Firestore (users or cms-users collection)",
      "2. syncAppUserRole / syncUserRoleFromCms Cloud Function fires",
      "3. Sets Firebase Auth custom claims: { role, isDriver, isClient }",
      "4. Backend functions check claims via getUserRole() (fast path) with Firestore fallback",
      "5. Frontend receives role via getIdTokenResult()"
    ]
  },
  
  "deployment": {
    "firestore_rules": "Deploy via: firebase deploy --only firestore:rules",
    "firestore_indexes": "Deploy via: firebase deploy --only firestore:indexes",
    "realtime_db_rules": "Deploy via: firebase deploy --only database",
    "rules_files": {
      "firestore": "database/firestore.rules",
      "realtime_db": "database/database.rules.json",
      "indexes": "database/firestore.indexes.json"
    }
  }
}
