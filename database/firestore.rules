rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDriver() {
      // Prefer custom claims (set via admin.auth().setCustomUserClaims)
      // isDriver: true covers both 'driver' and 'designated_driver'
      // Falls back to Firestore lookup if claims not present
      return isAuthenticated() &&
             (request.auth.token.isDriver == true ||
              request.auth.token.role == 'driver' ||
              request.auth.token.role == 'designated_driver' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'designated_driver');
    }

    function isAdmin() {
      // Prefer custom claims (set via admin.auth().setCustomUserClaims)
      // Falls back to Firestore lookup if claim not present
      return isAuthenticated() &&
             (request.auth.token.role == 'admin' ||
              get(/databases/$(database)/documents/cms-users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // ============================================
    // USERS COLLECTION
    // Perfiles de usuarios (sincronizado con Firebase Auth)
    // ============================================
    
    match /users/{userId} {
      // Cualquier usuario autenticado puede leer perfiles
      allow read: if isAuthenticated();
      
      // Solo el dueño puede crear su perfil — role forzado a 'client'
      allow create: if isOwner(userId) && 
                      request.resource.data.id == userId &&
                      request.resource.data.keys().hasAll(['id', 'email', 'name', 'role']) &&
                      request.resource.data.id is string &&
                      request.resource.data.email is string &&
                      request.resource.data.name is string &&
                      request.resource.data.role is string &&
                      request.resource.data.role == 'client';
      
      // Solo el dueño puede actualizar su perfil (sin cambiar role)
      allow update: if isOwner(userId) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'name', 'phone', 'profilePhoto', 'fcmToken',
                        'notificationsEnabled', 'currentRideId',
                        'driverStatus', 'currentLocation', 'stats',
                        'updatedAt'
                      ]);
      
      // El dueño puede eliminar su perfil (para eliminar cuenta)
      allow delete: if isOwner(userId);

      // Subcolección de tokens FCM (path real usado por Cloud Functions)
      match /fcmTokens/{tokenId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    match /cms-users/{userId} {
      // Solo admin o el propio usuario CMS puede leer
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // SERVICE AREAS
    // Zonas de servicio y cobertura geográfica
    // ============================================

    match /service_areas/{areaId} {
      // Cualquier usuario autenticado puede leer las áreas de servicio
      allow read: if isAuthenticated();

      // Solo administradores pueden crear/actualizar/eliminar áreas
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // NOTIFICATIONS SUBCOLLECTION
    // Notificaciones de usuarios
    // Path: notifications/{userId}/items/{notificationId}
    // ============================================
    
    match /notifications/{userId}/items/{notificationId} {
      // Solo el dueño puede leer sus notificaciones
      allow read: if isOwner(userId);
      
      // Solo el dueño puede marcar como leída (solo campos read y readAt)
      allow update: if isOwner(userId) && 
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      
      // Solo el sistema puede crear notificaciones (via Cloud Functions)
      allow create: if false;
      
      // El dueño puede eliminar sus notificaciones
      allow delete: if isOwner(userId);
    }
    // ============================================
    // FCM TOKENS
    // Tokens de notificación push — movidos a subcolección users/{userId}/fcmTokens
    // La colección raíz fcmTokens ya no se usa (path legacy)
    // ============================================
  }
}
