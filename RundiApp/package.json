{
  "name": "rundi",
  "version": "1.9.8",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-maps"
      ]
    }
  },
  "scripts": {
    "start": "expo start --clear",
    "start:dev": "node scripts/switch-env.js development && expo start --clear",
    "start:local": "node scripts/dev-local.cjs",
    "stop:docker": "node scripts/dev-local.cjs stop:docker",
    "stop:firebase": "node scripts/dev-local.cjs stop:firebase",
    "stop:all": "node scripts/dev-local.cjs stop:all",
    "start:prod": "node scripts/switch-env.js production && expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "env:dev": "node scripts/switch-env.js development",
    "env:prod": "node scripts/switch-env.js production",
    "prebuild:clean": "npx expo prebuild --clean",
    "prebuild:clean:android": "npx expo prebuild --clean --platform android",
    "prebuild:clean:ios": "npx expo prebuild --clean --platform ios",
    "ios:unsigned": "EXPO_UNSIGNED=1 expo run:ios",
    "start:local:v2": "node ../local-dev/dev-local-v2.cjs start",
    "stop:local:v2": "node ../local-dev/dev-local-v2.cjs stop",
    "status:local:v2": "node ../local-dev/dev-local-v2.cjs status",
    "logs:local:v2": "node ../local-dev/dev-local-v2.cjs logs",
    "seed:local:v2": "node ../local-dev/dev-local-v2.cjs seed",
    "stop:all:local:v2": "node ../local-dev/dev-local-v2.cjs stop:all"
  },
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@livekit/react-native-webrtc": "^150.2.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/app-check": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "axios": "^1.13.2",
    "expo": "^58.0.0",
    "expo-apple-authentication": "~58.0.3",
    "expo-asset": "~58.0.21",
    "expo-auth-session": "~58.0.19",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.4",
    "expo-local-authentication": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-sensors": "~58.0.5",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-task-manager": "~58.0.14",
    "expo-web-browser": "~58.1.0",
    "firebase": "^12.7.0",
    "i18next": "^25.7.4",
    "livekit-client": "^2.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^16.5.2",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "^1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "decode-uri-component": "^0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native/jest-preset": "^0.88.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~58.0.0",
    "expo-module-scripts": "^56.0.3",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "react-native-dotenv": "^3.4.11",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo"
  }
}
