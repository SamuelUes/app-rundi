# ============================================
# FRONTEND .env - DriveAngel.ni
# ============================================
# IMPORTANTE: Este archivo contiene configuraciones del CLIENTE
# Las credenciales de Firebase aquí son PÚBLICAS (se usan en el navegador/app)
# Es seguro subirlas al repositorio

# ============================================
# BACKEND MODE
# ============================================
# Opciones: 'firebase' o 'local'
BACKEND_MODE=firebase

# true = usa emuladores locales, false = usa Firebase producción
USE_FIREBASE_EMULATORS=false

# ============================================
# FIREBASE - PRODUCCIÓN
# ============================================
# Estas credenciales son PÚBLICAS (se usan en el cliente)
# Puedes obtenerlas en: Firebase Console > Project Settings > Your apps
FIREBASE_API_KEY=tu-firebase-api-key
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto-id
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef123456
FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com

# Firebase Functions URL
API_BASE_URL_FIREBASE=https://us-central1-tu-proyecto.cloudfunctions.net
WS_URL_FIREBASE=https://tu-proyecto-default-rtdb.firebaseio.com

# ============================================
# NESTJS LOCAL (Solo si BACKEND_MODE=local)
# ============================================
API_BASE_URL_LOCAL=http://localhost:3000/api
WS_URL_LOCAL=http://localhost:3000

# ============================================
# GOOGLE OAUTH 2.0 (Autenticación)
# ============================================
# Google Client ID para Android/Expo
# Obtén tu Client ID en: Google Cloud Console > APIs & Services > Credentials
# Para Expo: Crea un OAuth Client ID tipo "Android"
REACT_APP_GOOGLE_CLIENT_ID=tu-google-client-id-android.apps.googleusercontent.com

# Google Client ID para Web (opcional, para versión web)
REACT_APP_GOOGLE_WEB_CLIENT_ID=tu-google-client-id-web.apps.googleusercontent.com

# ============================================
# GOOGLE MAPS API
# ============================================
# API Key para Google Maps (debe estar restringida a tu dominio/app)
# Obtén tu key en: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=tu-google-maps-api-key

# ============================================
# STRIPE (Pagos)
# ============================================
# Publishable Key (es PÚBLICA, se usa en el cliente)
STRIPE_PUBLISHABLE_KEY=pk_test_tu-stripe-publishable-key

# ============================================
# SENTRY (Error Tracking) - OPCIONAL
# ============================================
SENTRY_DSN=https://tu-sentry-dsn@sentry.io/proyecto

# ============================================
# CONFIGURACIÓN DE LA APP
# ============================================
APP_NAME=conduce-ni-ni
APP_VERSION=1.0.01
ENVIRONMENT=production

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. Las credenciales de Firebase son PÚBLICAS (se usan en el cliente)
# 2. Google Maps API Key debe estar restringida a tu dominio/bundle ID
# 3. Stripe Publishable Key es PÚBLICA (la Secret Key va en el backend)
# 4. Copia este archivo como .env y completa con tus valores reales
