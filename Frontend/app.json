{
  "expo": {
    "name": "Rundi",
    "slug": "rundi",
    "version": "Beta - 1.6.4",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/images/jpg",
    "scheme": "com.driveangel.rundidev",
    "owner": "samuelues",
    "projectId": "79fc9fff-5481-4aba-a29a-632db706c382",
    "runtimeVersion": "Beta - 1.6.4",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.driveangel.rundidev",
      "userInterfaceStyle": "automatic",
      "allowBackup": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "ACTIVITY_RECOGNITION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/icon_1.2.jpg",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "${GOOGLE_MAPS_API_KEY}"
        }
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "rundi"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "useNextNotificationsApi": true
    },
    "ios": {
      "bundleIdentifier": "com.driveangel.rundidev",
      "urlSchemes": ["driveangel", "tel", "mailto", "whatsapp", "waze", "googlemaps"],
      "infoPlist": {
        "NSMotionUsageDescription": "Rundi utiliza tu actividad física para detectar cuándo estás manejando y mejorar la asignación de viajes."
      },
      "userInterfaceStyle": "automatic"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir a Rundi acceder a tu ubicación para rastrear tu viaje."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir uso de FaceID"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/icon_1.2.jpg",
          "color": "#FF9800",
          "sounds": ["./src/assets/sounds/notification.wav"],
          "mode": "production"
        }
      ],
      [
        "expo-google-app-auth",
        {
          "iosClientId": "1040329608349-tl5cpqbf5gn10atmspkq7ligjivebuji.apps.googleusercontent.com",
          "androidClientId": "1040329608349-t11k2f7tu1gtrh8fpogu3n1gmf2gi8p3.apps.googleusercontent.com"
        }
      ],
      [
        "react-native-firebase",
        {
          "messaging_android_notification_channel_id": "default",
          "messaging_android_notification_priority": "priority_high"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "79fc9fff-5481-4aba-a29a-632db706c382"
      },
      "domain": "rundiapp.com",
      "apiUrl": "",
      "wsUrl": "",
      "supabaseUrl": "https://cypllfzespkzhtyeitlv.supabase.co",
      "supabaseKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN5cGxsZnplc3Bremh0eWVpdGx2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjQyNTExMTMsImV4cCI6MjA3OTgyNzExM30.8PN8T7kaf_acPFJAkONgqec8zxePnu8hwZ_gXkkGJ78"
    }
  }
}
