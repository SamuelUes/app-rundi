import React, { useState, useEffect, useMemo } from 'react';
import {
  View,
  Text,
  StyleSheet,
  TouchableOpacity,
  ActivityIndicator,
  Alert,
  Linking,
  ScrollView,
} from 'react-native';
import { useTheme } from '../../context/ThemeContext';
import ridesService from '../../services/ridesService';

interface RideConfirmationScreenProps {
  route: {
    params: {
      rideId: string;
    };
  };
  navigation: any;
}

export default function RideConfirmationScreen({ route, navigation }: RideConfirmationScreenProps) {
  const { rideId } = route.params;
  const { colors } = useTheme();
  const styles = useMemo(() => createStyles(colors), [colors]);
  const [ride, setRide] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [canceling, setCanceling] = useState(false);

  useEffect(() => {
    loadRideDetails();
    
    // Polling cada 5 segundos para actualizar el estado
    const interval = setInterval(loadRideDetails, 5000);
    return () => clearInterval(interval);
  }, [rideId]);

  const loadRideDetails = async () => {
    try {
      const rideData = await ridesService.getRideDetails(rideId);
      setRide(rideData);
      
      // Si el viaje fue aceptado y no estamos ya en la pantalla de pago
      // Mostrar información del conductor primero
      if (rideData.status === 'accepted' && !ride) {
        // Primera vez que se acepta, mostrar info del conductor
        setRide(rideData);
      } else if (rideData.status === 'driver_arrived') {
        // Conductor ha llegado, navegar a tracking
        navigation.replace('RideTracking', {
          rideId: rideData.id,
          driverId: rideData.driverId || '',
          driverName: rideData.driver?.name || 'Conductor',
          vehiclePlate: rideData.driver?.vehicle?.plate || 'N/A',
          estimatedFare: rideData.estimatedPrice || 0,
        });
      }
      
      // Si el viaje ya está en progreso, ir directo al tracking
      if (rideData.status === 'in_progress') {
        navigation.replace('RideTracking', {
          rideId: rideData.id,
          driverId: rideData.driverId || '',
          driverName: 'Conductor', // TODO: Obtener del backend
          vehiclePlate: 'N/A', // TODO: Obtener del backend
          estimatedFare: rideData.estimatedPrice || 0,
        });
      }
    } catch (error) {
      console.error('Error loading ride:', error);
    } finally {
      setLoading(false);
    }
  };

  const handleCancelRide = () => {
    Alert.alert(
      'Cancelar Viaje',
      '¿Estás seguro que deseas cancelar este viaje?',
      [
        { text: 'No', style: 'cancel' },
        {
          text: 'Sí, cancelar',
          style: 'destructive',
          onPress: async () => {
            try {
              setCanceling(true);
              await ridesService.cancelRide(rideId, 'Cancelado por el cliente');
              Alert.alert('Viaje Cancelado', 'Tu viaje ha sido cancelado exitosamente', [
                { text: 'OK', onPress: () => navigation.navigate('ClientHome') },
              ]);
            } catch (error: any) {
              Alert.alert('Error', error.response?.data?.message || 'No se pudo cancelar el viaje');
            } finally {
              setCanceling(false);
            }
          },
        },
      ]
    );
  };

  const handleCallSupport = () => {
    Linking.openURL('tel:+50512345678'); // TODO: Número real de soporte
  };

  if (loading || !ride) {
    return (
      <View style={styles.loadingContainer}>
        <ActivityIndicator size="large" color="#000" />
        <Text style={styles.loadingText}>Cargando detalles del viaje...</Text>
      </View>
    );
  }

  return (
    <ScrollView style={styles.container} contentContainerStyle={styles.scrollContent}>
      {/* Header */}
      <View style={styles.header}>
        <View style={styles.statusContainer}>
          <View style={styles.statusDot} />
          <Text style={styles.statusText}>
            {ride.status === 'requested' ? 'Buscando conductor...' : 'Viaje confirmado'}
          </Text>
        </View>
      </View>

      {/* Animación de búsqueda */}
      {ride.status === 'requested' && (
        <View style={styles.searchingContainer}>
          <ActivityIndicator size="large" color="#2196F3" />
          <Text style={styles.searchingTitle}>Buscando conductor disponible</Text>
          <Text style={styles.searchingText}>
            Estamos notificando a los conductores cercanos.{'\n'}
            Esto puede tomar unos momentos.
          </Text>
        </View>
      )}

      {/* Información del conductor (cuando es aceptado) */}
      {ride.status === 'accepted' && ride.driver && (
        <View style={styles.driverContainer}>
          <Text style={styles.driverTitle}>🎉 ¡Conductor encontrado!</Text>
          
          <View style={styles.driverCard}>
            <View style={styles.driverAvatar}>
              <Text style={styles.driverAvatarText}>
                {ride.driver.name.charAt(0).toUpperCase()}
              </Text>
            </View>
            
            <View style={styles.driverInfo}>
              <Text style={styles.driverName}>{ride.driver.name}</Text>
              <View style={styles.driverRating}>
                <Text style={styles.driverRatingText}>⭐ {ride.driver.rating ? ride.driver.rating.toFixed(1) : '5.0'}</Text>
              </View>
              {ride.driver.vehicle && (
                <>
                  <Text style={styles.driverVehicle}>
                    {ride.driver.vehicle.brand} {ride.driver.vehicle.model} • {ride.driver.vehicle.color}
                  </Text>
                  <Text style={styles.driverPlate}>Placa: {ride.driver.vehicle.plate}</Text>
                </>
              )}
            </View>
          </View>

          <View style={styles.etaContainer}>
            <Text style={styles.etaLabel}>Tiempo estimado de llegada</Text>
            <Text style={styles.etaValue}>5-10 minutos</Text>
          </View>

          <TouchableOpacity
            style={styles.proceedButton}
            onPress={() => navigation.replace('RideTracking', {
              rideId: ride.id,
              driverId: ride.driverId,
              driverName: ride.driver.name,
              estimatedFare: ride.estimatedPrice,
            })}
          >
            <Text style={styles.proceedButtonText}>Ver en Mapa 🗺️</Text>
          </TouchableOpacity>
      </View>
    </ScrollView>
  );
}

      {/* Detalles del viaje */}
      <View style={styles.detailsContainer}>
        <Text style={styles.sectionTitle}>Detalles del Viaje</Text>
        {ride.status === 'in_progress' && (
          <View style={styles.inProgressContainer}>
            <Text style={styles.inProgressText}>El viaje ya ha comenzado</Text>
        <View style={styles.locationContainer}>
          <View style={styles.locationRow}>
            <Text style={styles.locationIcon}>🔵</Text>
            <View style={styles.locationInfo}>
              <Text style={styles.locationLabel}>Origen</Text>
              <Text style={styles.locationAddress}>{ride.originAddress}</Text>
            </View>
          </View>

          <View style={styles.locationDivider} />

          <View style={styles.locationRow}>
            <Text style={styles.locationIcon}>🔴</Text>
            <View style={styles.locationInfo}>
              <Text style={styles.locationLabel}>Destino</Text>
              <Text style={styles.locationAddress}>{ride.destinationAddress}</Text>
            </View>
          </View>
        </View>

        <View style={styles.infoGrid}>
          <View style={styles.infoCard}>
            <Text style={styles.infoLabel}>Distancia</Text>
            <Text style={styles.infoValue}>{ride.estimatedDistance ? (ride.estimatedDistance / 1000).toFixed(1) : '0.0'} km</Text>
          </View>
          <View style={styles.infoCard}>
            <Text style={styles.infoLabel}>Duración</Text>
            <Text style={styles.infoValue}>{ride.estimatedDuration ? Math.round(ride.estimatedDuration / 60) : '0'} min</Text>
          </View>
          <View style={styles.infoCard}>
            <Text style={styles.infoLabel}>Precio</Text>
            <Text style={styles.infoValue}>C${ride.estimatedFare || ride.estimatedPrice || 0}</Text>
          </View>
        </View>

        {ride.notes && (
          <View style={styles.notesContainer}>
            <Text style={styles.notesLabel}>Notas:</Text>
            <Text style={styles.notesText}>{ride.notes}</Text>
          </View>
        )}
      </View>

      {/* Botones de acción */}
      <View style={styles.actionsContainer}>
        <TouchableOpacity
          style={styles.supportButton}
          onPress={handleCallSupport}
        >
          <Text style={styles.supportButtonText}>📞 Llamar a Soporte</Text>
        </TouchableOpacity>

        <TouchableOpacity
          style={[styles.cancelButton, canceling && styles.cancelButtonDisabled]}
          onPress={handleCancelRide}
          disabled={canceling}
        >
          <Text style={styles.cancelButtonText}>
            {canceling ? 'Cancelando...' : 'Cancelar Viaje'}
          </Text>
        </TouchableOpacity>
      </View>

      {/* Información adicional */}
      <View style={styles.footer}>
        <Text style={styles.footerText}>
          💡 Recibirás una notificación cuando un conductor acepte tu viaje
        </Text>
        <Text style={[styles.footerText, { marginTop: 8 }]}>
          💬 Podrás chatear con el conductor una vez que acepte el viaje
        </Text>
      </View>
    </View>
  );
}

