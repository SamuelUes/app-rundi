# ============================================
# FRONTEND .env - Producción Rundi (PROD)
# VALORES VACÍOS: rellena con las credenciales del nuevo proyecto oficial
# ============================================

# ============================================
# BACKEND MODE
# ============================================
BACKEND_MODE=firebase
USE_FIREBASE_EMULATORS=false

# ============================================
# FIREBASE - PRODUCCIÓN Rundi
# ============================================
# Firebase API Keys

FIREBASE_API_ANDROID_KEY=
FIREBASE_API_IOS_KEY=
#FIREBASE_API_BROWSER_KEY=

# Firebase Auth
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_DATABASE_URL=

# Firebase Functions URL
API_BASE_URL_FIREBASE=
WS_URL_FIREBASE=

# ============================================
# NESTJS LOCAL (Solo si BACKEND_MODE=local)
# ============================================
API_BASE_URL_LOCAL=
WS_URL_LOCAL=

# ============================================
# SUPABASE POSTGRESQL (PROD)
# ============================================
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# ============================================
# SUPABASE STORAGE (PROD)
# ============================================
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ============================================
# MAPS APIs (PROD)
# ============================================

GOOGLE_MAPS_API_KEY=
TOMTOM_API_KEY=
MAPBOX_TOKEN=

# ============================================
# OTROS
# ============================================
NODE_ENV=production
DOMAIN=

# ============================================
# GOOGLE OAUTH 2.0 (Autenticación)
# ============================================
# Google Client IDs para Rundi (rellenar)
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_GOOGLE_CLIENT_ID_ANDROID=
REACT_APP_GOOGLE_CLIENT_ID_IOS=
REACT_APP_GOOGLE_URL_SCHEME=
