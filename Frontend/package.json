{
  "name": "rundi",
  "version": "1.6.4",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-maps"
      ]
    }
  },
  "scripts": {
    "start": "expo start --clear",
    "start:dev": "node scripts/switch-env.js development && expo start --clear",
    "start:local": "node scripts/dev-local.cjs",
    "stop:docker": "node scripts/dev-local.cjs stop:docker",
    "stop:firebase": "node scripts/dev-local.cjs stop:firebase",
    "stop:all": "node scripts/dev-local.cjs stop:all",
    "start:prod": "node scripts/switch-env.js production && expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "env:dev": "node scripts/switch-env.js development",
    "env:prod": "node scripts/switch-env.js production",
    "prebuild:clean": "npx expo prebuild --clean",
    "prebuild:clean:android": "npx expo prebuild --clean --platform android",
    "prebuild:clean:ios": "npx expo prebuild --clean --platform ios",
    "ios:unsigned": "EXPO_UNSIGNED=1 expo run:ios"
  },
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@livekit/react-native-webrtc": "^137.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/app-check": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/database": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@supabase/supabase-js": "^2.90.1",
    "axios": "^1.13.2",
    "expo": "~57.0.27",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.19",
    "expo-auth-session": "~57.0.14",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.7.0",
    "i18next": "^25.7.4",
    "livekit-client": "^2.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.2",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "^1.29.11",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.14",
    "expo-module-scripts": "56.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-native-dotenv": "^3.4.11",
    "supabase": "2.118.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo"
  }
}
