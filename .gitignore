# Environment files
# IMPORTANTE: Se ignoran todos los .env EXCEPTO el del Frontend
#.env
#.env.local
#.env.production
#.env.*.local

# PERMITIR archivos .env.example (son plantillas sin datos sensibles)
!.env.example
!**/.env.example

# Permitir .env del Frontend (para configuración del cliente)
!Frontend/.env
!Frontend/.env.local
!Frontend/.env.production

# Mantener ignorados los .env de Backend y Functions (contienen secrets)
#functions/.env
#functions/.env.development
#functions/.env.production
#Backend/.env
#Backend/.env.*

# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/
*.log

# Production builds
dist/
build/
*.tsbuildinfo

# Expo
.expo/
.expo-shared/

# Firebase
firebase-service-account.json
*-firebase-adminsdk-*.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Secrets
*.pem
*.key
*.cert

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database
*.db
*.sqlite
*.sqlite3

# Temporary files
tmp/
temp/
*.tmp

# Carpetas ignoradas (legacy)
Backend/
docs/
database/
supabase.ts

# Permitidos
!database/supabase-only.sql

# Frontend - PERMITIR .env para APIs públicas (Google Maps, etc.)
# El .env del Frontend se permite porque contiene solo APIs del cliente